<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Label" name="outcome-label" style="-unity-text-align: upper-center; margin-top: 119px;"/>
    <ui:Label text="Label" name="first-player-score-label" style="-unity-text-align: upper-center;"/>
    <ui:Label text="Label" name="second-player-score-label" style="-unity-text-align: upper-center;"/>
    <ui:Button text="Find Game" name="find-game-again-button" style="background-color: rgb(99, 192, 249); align-content: center; align-self: center; justify-content: center; align-items: center; width: 200px;"/>
    <ui:Button text="Exit" name="exit-button" style="align-content: center; align-self: center; justify-content: space-evenly; align-items: center; width: 200px;"/>
</ui:UXML>
